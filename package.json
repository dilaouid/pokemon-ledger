{
  "name": "pokemon-ledger",
  "private": true,
  "description": "Retro game played with a Ledger device. Progress is stored as ERC-721 tokens on Sepolia.",
  "version": "1.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "chain:compile": "hardhat compile --config chain/hardhat.config.cjs && node chain/scripts/export-artifact.cjs && node chain/scripts/export-portraits.cjs",
    "nft:export": "node chain/scripts/export-portraits.cjs",
    "chain:test": "hardhat test --config chain/hardhat.config.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ledgerhq/wallet-api-client": "^1.16.0",
    "bignumber.js": "9.3.1",
    "buffer": "^6.0.3",
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "1.51.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "hardhat": "2.26.3",
    "solc": "0.8.28",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^3.2.0"
  }
}
